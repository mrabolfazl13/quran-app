node_modules/
dist/
build/
target/
*.tsbuildinfo
.DS_Store
.idea/
.vscode/

# raw downloads and generated packs (rebuilt by tools/content)
data/raw/
data/build/
data/*.log

# local-AI measurement harness: never a product dependency, and its 260 MB of
# ONNX graphs plus its own tree are re-downloadable, so they stay off the repo.
experiments/local-ai/models/
experiments/local-ai/node_modules/
experiments/models/

# local databases produced by running the app
*.sqlite
*.sqlite-journal
*.wal
*.shm
*.sqlite-shm

# staged copies of the generated packs (scripts/stageContent.mjs). They are
# byte-for-byte copies of `content/`, which is itself a build product, so
# committing them would only let the shipped bytes drift from the validated
# ones.
desktop/src-tauri/content/

# packaged deliverables (scripts/packageWeb.mjs): a copied dist/, the staged
# packs and the zip. Rebuildable in one command, and 37 MB of them.
desktop/release/
