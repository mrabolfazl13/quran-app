{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sync:schema && tsc --noEmit && npm run build:vite",
    "build:vite": "npm run sync:schema && vite build && node scripts/stageContent.mjs --to=both",
    "preview": "vite preview",
    "web:serve": "npm run build:vite && node scripts/serveWeb.mjs",
    "web:package": "npm run build:vite && node scripts/packageWeb.mjs --zip",
    "stage:content": "node scripts/stageContent.mjs --to=both",
    "sync:schema": "node scripts/syncSchema.mjs",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
